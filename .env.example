# Copy to `.env.local` and fill in from your Supabase project settings.
#
# Both values are safe to ship in a client build: the anon key is designed to be
# public, and row-level security in the database is what actually protects the
# data. Never put the service-role key in this file — it bypasses RLS.
#
# Leave these unset to run Masari fully offline, on-device only.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
